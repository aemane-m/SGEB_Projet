<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="854.0" prefWidth="991.0" spacing="12" styleClass="dashboard-root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.ui.viewmodel.controller.PenalitesController">

    <padding>
        <Insets bottom="20" left="48" right="48" top="28" />
    </padding>

    <!-- ========== EN-TÊTE ========== -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <children>
            <Label styleClass="title" text="Gestion des Pénalités" />

            <Region HBox.hgrow="ALWAYS" />

            <ProgressIndicator fx:id="progress" managed="false" visible="false" />

            <Button fx:id="btnRefresh" styleClass="btn-primary" text="Rafraîchir" />
        </children>
    </HBox>

    <!-- ========== MESSAGES ========== -->
    <Label fx:id="errorLabel" managed="false" styleClass="error-message" visible="false" wrapText="true" />

    <Label fx:id="successLabel" managed="false" styleClass="success-message" visible="false" wrapText="true" />

    <!-- ========== TABLE PRINCIPALE : ADHÉRENTS AVEC PÉNALITÉS ========== -->
    <VBox spacing="10" styleClass="card">
        <children>

            <Label styleClass="section-title" text="Adhérents avec pénalités actives" />

            <TableView fx:id="tableAdherents" prefHeight="690.0" prefWidth="863.0" styleClass="data-table">

                <columns>
                    <TableColumn fx:id="colAdherentNom" prefWidth="210.75186920166016" resizable="false" text="Adhérent" />

                    <TableColumn fx:id="colPenaliteCount" prefWidth="181.24819946289062" resizable="false" text="Pénalités actives" />

                    <TableColumn fx:id="colPenaliteRequested" prefWidth="235.1204833984375" resizable="false" text="Demandes de paiement" />

                    <TableColumn fx:id="colPenaliteTotal" prefWidth="234.4136962890625" resizable="false" text="Total dû" />
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>

                <placeholder>
                    <Label text="Aucun adhérent n'a de pénalité active." />
                </placeholder>
            </TableView>

        </children>
    </VBox>

    <!-- ========== TABLE DÉTAILLÉE ========== -->
    <VBox fx:id="detailsPane" managed="false" spacing="10" styleClass="card" visible="false" VBox.vgrow="ALWAYS">

        <children>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <children>
                    <Label styleClass="section-title" text="Détail des pénalités" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Button fx:id="btnReglerTout" styleClass="btn-primary" text="Tout régler pour cet adhérent" />
                </children>
            </HBox>

            <TableView fx:id="tableDetails" prefHeight="300" styleClass="data-table" VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="colDetailDoc" prefWidth="300" text="Document" />

                    <TableColumn fx:id="colDetailDate" prefWidth="150" text="Date" />

                    <TableColumn fx:id="colDetailMontant" prefWidth="120" text="Montant" />

                    <TableColumn fx:id="colDetailAction" prefWidth="120" text="Action" />
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>

                <placeholder>
                    <Label text="Sélectionnez un adhérent ci-dessus pour voir le détail." />
                </placeholder>

            </TableView>
        </children>
    </VBox>

</VBox>
