<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" styleClass="dashboard-root"
      stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.ui.viewmodel.controller.PenalitesController">

    <padding>
        <Insets bottom="20" left="48" right="48" top="28" />
    </padding>

    <!-- EN-TÊTE -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="title" text="Gestion des Pénalités" />
        <Region HBox.hgrow="ALWAYS" />
        <ProgressIndicator fx:id="progress" managed="false" visible="false" />
        <Button fx:id="btnRefresh" styleClass="btn-secondary" text="Rafraîchir" />
    </HBox>

    <!-- MESSAGES -->
    <Label fx:id="errorLabel" managed="false" styleClass="error-message" visible="false" wrapText="true" />
    <Label fx:id="successLabel" managed="false" styleClass="success-message" visible="false" wrapText="true" />

    <!-- TABLE PRINCIPALE (Adhérents)-->
    <VBox spacing="10" styleClass="card">
        <Label styleClass="section-title" text="Adhérents avec pénalités actives" />

        <TableView fx:id="tableAdherents" prefHeight="250" styleClass="data-table">

            <columns>
                <TableColumn fx:id="colAdherentNom"
                             prefWidth="200.0" resizable="false"
                             text="Adhérent" />

                <TableColumn fx:id="colPenaliteCount"
                             prefWidth="140.0" resizable="false"
                             text="Pénalités actives" />

                <TableColumn fx:id="colPenaliteRequested"
                             prefWidth="160.0" resizable="false"
                             text="Demandes de paiement" />

                <TableColumn fx:id="colPenaliteTotal"
                             prefWidth="140.0" resizable="false"
                             text="Total dû" />
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>

            <placeholder>
                <Label text="Aucun adhérent n'a de pénalité active." />
            </placeholder>
        </TableView>
    </VBox>

    <!-- TABLE DÉTAILLÉE -->
    <VBox fx:id="detailsPane"
          managed="false" visible="false"
          spacing="10" styleClass="card"
          VBox.vgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="section-title" text="Détail des pénalités" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnReglerTout" styleClass="btn-primary" text="Tout régler pour cet adhérent" />
        </HBox>

        <TableView fx:id="tableDetails" prefHeight="300"
                   styleClass="data-table"
                   VBox.vgrow="ALWAYS">

            <columns>
                <TableColumn fx:id="colDetailDoc"
                             prefWidth="300" text="Document" />

                <TableColumn fx:id="colDetailDate"
                             prefWidth="150" text="Date" />

                <TableColumn fx:id="colDetailMontant"
                             prefWidth="120" text="Montant" />

                <TableColumn fx:id="colDetailAction"
                             prefWidth="120" text="Action" />
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>

            <placeholder>
                <Label text="Sélectionnez un adhérent ci-dessus pour voir le détail." />
            </placeholder>
        </TableView>
    </VBox>

</VBox>