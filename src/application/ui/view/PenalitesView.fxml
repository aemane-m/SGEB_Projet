<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Imports pour les types de données dans les TableView -->
<?import application.ui.viewmodel.PenalitesViewModel.AdherentPenaliteSummary?>
<?import application.domain.core.emprunt.Penalite?>

<VBox spacing="12" stylesheets="@../css/style.css" styleClass="dashboard-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.ui.viewmodel.controller.PenalitesController">
    <padding>
        <Insets bottom="20" left="48" right="48" top="28" />
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="title" text="Gestion des Pénalités" />
        <Region HBox.hgrow="ALWAYS" />
        <ProgressIndicator fx:id="progress" managed="false" visible="false" />
        <Button fx:id="btnRefresh" styleClass="btn-secondary" text="Rafraîchir" />
    </HBox>

    <!-- Messages -->
    <Label fx:id="errorLabel" managed="false" styleClass="error-message" visible="false" wrapText="true" />
    <Label fx:id="successLabel" managed="false" styleClass="success-message" visible="false" wrapText="true" />

    <!-- Table Maître : Adhérents avec pénalités -->
    <VBox styleClass="card" spacing="10">
        <Label styleClass="section-title" text="Adhérents avec pénalités actives" />
        <TableView fx:id="tableAdherents" prefHeight="250">
            <columns>
                <TableColumn fx:id="colAdherentNom" prefWidth="300" text="Adhérent" />
                <TableColumn fx:id="colPenaliteCount" prefWidth="150" text="Pénalités Actives" />
                <TableColumn fx:id="colPenaliteTotal" prefWidth="150" text="Total Dû" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
            <placeholder><Label text="Aucun adhérent n'a de pénalité active." /></placeholder>
        </TableView>
    </VBox>

    <!-- CORRIGÉ : Table Détail (masquée par défaut) -->
    <VBox fx:id="detailsPane" styleClass="card" spacing="10" VBox.vgrow="ALWAYS" visible="false" managed="false">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="section-title" text="Détail des pénalités" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnReglerTout" styleClass="btn-primary" text="Tout Régler pour cet Adhérent" />
        </HBox>
        
        <TableView fx:id="tableDetails" prefHeight="300" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDetailDoc" prefWidth="300" text="Document" />
                <TableColumn fx:id="colDetailDate" prefWidth="150" text="Date de génération" />
                <TableColumn fx:id="colDetailMontant" prefWidth="120" text="Montant" />
                <TableColumn fx:id="colDetailAction" prefWidth="120" text="Action" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
            <placeholder><Label text="Sélectionnez un adhérent ci-dessus pour voir le détail." /></placeholder>
        </TableView>
    </VBox>

</VBox>

