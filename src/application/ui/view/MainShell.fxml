<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
  CORRIGÉ : L'icône "Catalogue" est remplacée par une icône "Bibliothèque".
-->
<BorderPane fx:id="rootPane" prefHeight="700" prefWidth="1200" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.ui.viewmodel.controller.MainShellController">

    <!-- ============================================= -->
    <!-- ZONE DE CONTENU PRINCIPALE (CENTRE)           -->
    <!-- ============================================= -->
    <center>
        <StackPane styleClass="app-surface">
            <AnchorPane fx:id="contentPane" />
        </StackPane>
    </center>

    <!-- ============================================= -->
    <!-- BARRE DE NAVIGATION (GAUCHE)                  -->
    <!-- ============================================= -->
    <left>
	    <VBox spacing="10" styleClass="sidebar">
	        <padding>
	            <Insets bottom="18" left="16" right="16" top="18" />
	        </padding>
	
	        <fx:define>
	            <ToggleGroup fx:id="navGroup" />
	        </fx:define>
	
	        <!-- 1. Marque / Logo -->
	        <HBox spacing="10" styleClass="brand">
	            <Label styleClass="brand-logo" text="📚" />
	            <VBox spacing="2">
	                <Label styleClass="brand-title" text="SGEB" />
	                <Label styleClass="brand-subtitle" text="Library Manager" />
	            </VBox>
	        </HBox>
	
	        <Separator styleClass="sep-light" />
	
	        <!-- 2. Navigation Principale -->
	        <VBox spacing="6" VBox.vgrow="ALWAYS">
	
	            <!-- Dashboard (commun) -->
	            <ToggleButton fx:id="btnDashboard"
	                          onAction="#goDashboard"
	                          selected="true"
	                          styleClass="nav-btn"
	                          text="Tableau de bord"
	                          toggleGroup="$navGroup"
	                          maxWidth="Infinity">
	                <graphic>
	                    <StackPane styleClass="svg-icon">
	                        <SVGPath content="M 12 2.0996094 L 1 12 L 4 12 L 4 21 L 10 21 L 10 14 L 14 14 L 14 21 L 20 21 L 20 12 L 23 12 L 12 2.0996094 z"
	                                 styleClass="svg-path" />
	                    </StackPane>
	                </graphic>
	            </ToggleButton>
	
	            <!-- Catalogue (commun) -->
	            <ToggleButton fx:id="btnCatalog"
	                          onAction="#goCatalog"
	                          styleClass="nav-btn"
	                          text="Catalogue"
	                          toggleGroup="$navGroup"
	                          maxWidth="Infinity">
	                <graphic>
	                    <StackPane styleClass="svg-icon">
	                        <SVGPath content="M 4 2 C 3.448 2 3 2.448 3 3 L 3 21 C 3 21.552 3.448 22 4 22 L 20 22 C 20.552 22 21 21.552 21 21 L 21 3 C 21 2.448 20.552 2 20 2 L 4 2 z M 4 4 L 20 4 L 20 20 L 4 20 L 4 4 z M 6 6 L 6 9 L 8 9 L 8 6 L 6 6 z M 10 6 L 10 9 L 12 9 L 12 6 L 10 6 z M 14 6 L 14 9 L 16 9 L 16 6 L 14 6 z M 6 11 L 6 14 L 8 14 L 8 11 L 6 11 z M 10 11 L 10 14 L 12 14 L 12 11 L 10 11 z M 14 11 L 14 14 L 16 14 L 16 11 L 14 11 z M 6 16 L 6 19 L 8 19 L 8 16 L 6 16 z M 10 16 L 10 19 L 12 19 L 12 16 L 10 16 z M 14 16 L 14 19 L 16 19 L 16 16 L 14 16 z"
	                                 styleClass="svg-path" />
	                    </StackPane>
	                </graphic>
	            </ToggleButton>
	
	            <!-- Bloc ADMIN -->
	            <ToggleButton fx:id="btnAdherents"
	                          onAction="#goAdherents"
	                          styleClass="nav-btn"
	                          text="Adhérents"
	                          toggleGroup="$navGroup"
	                          maxWidth="Infinity">
	                <graphic>
	                    <StackPane styleClass="svg-icon">
	                        <SVGPath content="M 12 2 C 9.791 2 8 3.791 8 6 C 8 8.209 9.791 10 12 10 C 14.209 10 16 8.209 16 6 C 16 3.791 14.209 2 12 2 z M 12 12 C 8.686 12 6 14.686 6 18 L 6 20 L 18 20 L 18 18 C 18 14.686 15.314 12 12 12 z"
	                                 styleClass="svg-path" />
	                    </StackPane>
	                </graphic>
	            </ToggleButton>
	
	            <ToggleButton fx:id="btnLoans"
	                          onAction="#goLoans"
	                          styleClass="nav-btn"
	                          text="Emprunts"
	                          toggleGroup="$navGroup"
	                          maxWidth="Infinity">
	                <graphic>
	                    <StackPane styleClass="svg-icon">
	                        <SVGPath content="M 9 4 L 9 6 L 15 6 L 15 4 L 9 4 z M 9 8 L 9 10 L 15 10 L 15 8 L 9 8 z M 9 12 L 9 14 L 13 14 L 13 12 L 9 12 z M 5 2 C 3.895 2 3 2.895 3 4 L 3 20 C 3 21.105 3.895 22 5 22 L 19 22 C 20.105 22 21 21.105 21 20 L 21 4 C 21 2.895 20.105 2 19 2 L 5 2 z M 5 4 L 19 4 L 19 20 L 5 20 L 5 4 z"
	                                 styleClass="svg-path" />
	                    </StackPane>
	                </graphic>
	            </ToggleButton>
	
	            <ToggleButton fx:id="btnPenalites"
	                          onAction="#goPenalites"
	                          styleClass="nav-btn"
	                          text="Pénalités"
	                          toggleGroup="$navGroup"
	                          maxWidth="Infinity">
	                <graphic>
	                    <StackPane styleClass="svg-icon">
	                        <SVGPath content="M 2 5 C 2 3.895 2.895 3 4 3 L 20 3 C 21.105 3 22 3.895 22 5 L 22 19 C 22 20.105 21.105 21 20 21 L 4 21 C 2.895 21 2 20.105 2 19 L 2 5 z M 4 5 L 20 5 L 20 8 L 4 8 L 4 5 z M 4 11 L 4 19 L 20 19 L 20 11 L 4 11 z M 6 13 L 10 13 L 10 15 L 6 15 L 6 13 z"
	                                 styleClass="svg-path" />
	                    </StackPane>
	                </graphic>
	            </ToggleButton>
	
	            <!-- Bloc ADHERENT -->
	            <ToggleButton fx:id="btnMesEmprunts"
	                          onAction="#goMesEmprunts"
	                          styleClass="nav-btn"
	                          text="Mes emprunts"
	                          toggleGroup="$navGroup"
	                          maxWidth="Infinity">
	                <graphic>
	                    <StackPane styleClass="svg-icon">
	                        <SVGPath content="M 6 4 L 6 20 L 18 20 L 18 4 L 6 4 z M 8 6 L 16 6 L 16 18 L 8 18 L 8 6 z M 10 8 L 10 10 L 14 10 L 14 8 L 10 8 z"
	                                 styleClass="svg-path" />
	                    </StackPane>
	                </graphic>
	            </ToggleButton>
	
	            <ToggleButton fx:id="btnMesPenalites"
	                          onAction="#goMesPenalites"
	                          styleClass="nav-btn"
	                          text="Mes pénalités"
	                          toggleGroup="$navGroup"
	                          maxWidth="Infinity">
	                <graphic>
	                    <StackPane styleClass="svg-icon">
	                        <SVGPath content="M 4 4 L 4 20 L 20 20 L 20 4 L 4 4 z M 6 6 L 18 6 L 18 18 L 6 18 L 6 6 z M 10 8 L 10 10 L 14 10 L 14 8 L 10 8 z M 10 12 L 10 14 L 14 14 L 14 12 L 10 12 z"
	                                 styleClass="svg-path" />
	                    </StackPane>
	                </graphic>
	            </ToggleButton>
	
	        </VBox>
	
	        <!-- 3. Section Utilisateur & Quitter -->
	        <VBox spacing="6">
	            <Separator styleClass="sep-light" />
	
	            <VBox spacing="2" styleClass="user-card">
	                <Label fx:id="lblUsername" styleClass="user-name" text="Connecté : ..." />
	                <Label fx:id="lblRole" styleClass="user-status" text="Rôle..." />
	            </VBox>
	
	            <Button onAction="#exitApp"
	                    styleClass="nav-btn, danger-btn"
	                    text="Quitter"
	                    maxWidth="Infinity">
	                <graphic>
	                    <StackPane styleClass="svg-icon">
	                        <SVGPath content="M 12 2 L 12 4 L 19 4 L 19 20 L 12 20 L 12 22 L 19 22 C 20.105 22 21 21.105 21 20 L 21 4 C 21 2.895 20.105 2 19 2 L 12 2 z M 9 6 L 7.59375 7.40625 L 10.1875 10 L 2 10 L 2 12 L 10.1875 12 L 7.59375 14.59375 L 9 16 L 14 11 L 9 6 z"
	                             styleClass="svg-path" />
	                    </StackPane>
	                </graphic>
	            </Button>
	        </VBox>
	
	    </VBox>
	</left>

</BorderPane>

