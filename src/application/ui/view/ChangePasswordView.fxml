<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.ui.viewmodel.controller.ChangePasswordController"
            stylesheets="@../css/style.css"
            styleClass="auth-root">

    <center>
        <VBox spacing="16" alignment="CENTER">
            <!-- ✅ CORRIGÉ : padding avec Insets, pas "20" brut -->
            <padding>
                <Insets top="32" right="32" bottom="32" left="32"/>
            </padding>

            <!-- Titre / info utilisateur -->
            <Label fx:id="lblUserInfo"
                   wrapText="true"
                   maxWidth="500"
                   styleClass="title"/>

            <!-- Messages d'erreur / succès -->
            <VBox spacing="4" maxWidth="500">
                <Label fx:id="errorLabel"
                       styleClass="error-message"
                       wrapText="true"
                       visible="false"
                       managed="false"/>

                <Label fx:id="successLabel"
                       styleClass="success-message"
                       wrapText="true"
                       visible="false"
                       managed="false"/>
            </VBox>

            <!-- Formulaire de changement de mot de passe -->
            <GridPane hgap="12" vgap="10" maxWidth="500">
                <columnConstraints>
                    <ColumnConstraints percentWidth="35"/>
                    <ColumnConstraints percentWidth="65"/>
                </columnConstraints>

                <Label text="Nouveau mot de passe :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <PasswordField fx:id="txtNewPassword"
                               promptText="Saisir un nouveau mot de passe"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Confirmer le mot de passe :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <PasswordField fx:id="txtConfirmPassword"
                               promptText="Retaper le même mot de passe"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- Boutons + loader -->
            <HBox spacing="12" alignment="CENTER">
                <Button fx:id="btnChange"
                        text="Mettre à jour le mot de passe"
                        onAction="#onChangePassword"/>

                <Button fx:id="btnCancel"
                        text="Annuler"
                        onAction="#onCancel"/>

                <ProgressIndicator fx:id="progress"
                                   prefWidth="24"
                                   prefHeight="24"
                                   visible="false"
                                   managed="false"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>