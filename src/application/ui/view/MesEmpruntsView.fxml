<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.lang.String?>

<BorderPane
        xmlns="http://javafx.com/javafx/23.0.1"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="application.ui.viewmodel.controller.MesEmpruntsController"
        prefHeight="549"
        prefWidth="835"
        stylesheets="@../css/style.css">

    <!-- ======================= HEADER ======================= -->
    <top>
        <VBox spacing="8">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
            </padding>

            <!-- Titre -->
            <HBox spacing="10">
                <children>
                    <Label text="Mes emprunts" styleClass="title" />
                    <Region HBox.hgrow="ALWAYS" />
                </children>
            </HBox>

            <!-- Filtres -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <children>
                    <CheckBox
                            fx:id="chkActifsOnly"
                            text="Afficher uniquement les emprunts en cours" />

                    <Region HBox.hgrow="ALWAYS" />

                    <ProgressIndicator
                            fx:id="progress"
                            prefWidth="20"
                            prefHeight="20"
                            visible="false"
                            managed="false" />

                    <Button fx:id="btnRefresh" text="Rafraîchir">
                        <styleClass>
                            <String fx:value="btn" />
                            <String fx:value="btn-secondary" />
                        </styleClass>
                    </Button>
                </children>
            </HBox>
        </VBox>
    </top>

    <!-- ======================= TABLEAU ======================= -->
    <center>
        <TableView fx:id="table" BorderPane.alignment="CENTER">
            <columns>

                <TableColumn
                        fx:id="colDocument"
                        text="Document"
                        prefWidth="180"
                        resizable="false" />

                <TableColumn
                        fx:id="colDateEmprunt"
                        text="Date d'emprunt"
                        prefWidth="140"
                        resizable="false" />

                <TableColumn
                        fx:id="colDatePrevue"
                        text="Retour prévu"
                        prefWidth="150"
                        resizable="false" />

                <TableColumn
                        fx:id="colDateRetour"
                        text="Retour effectif"
                        prefWidth="170"
                        resizable="false" />

                <TableColumn
                        fx:id="colStatut"
                        text="Statut"
                        prefWidth="195"
                        resizable="false" />

            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>

        </TableView>
    </center>

    <!-- ======================= BAS DE PAGE ======================= -->
    <bottom>
        <VBox spacing="8" prefHeight="160" prefWidth="835">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
            </padding>

            <!-- Messages -->
            <Label
                    fx:id="errorLabel"
                    styleClass="error-message"
                    visible="false"
                    managed="false"
                    wrapText="true" />

            <Label
                    fx:id="successLabel"
                    styleClass="success-message"
                    visible="false"
                    managed="false"
                    wrapText="true" />

            <!-- Formulaire d'emprunt adhérent -->
            <HBox spacing="8">
                <children>

                    <Label
                            prefWidth="200"
                            prefHeight="50"
                            alignment="CENTER"
                            text="Emprunter un document :"
                            style="-fx-font-weight: bold;">
                        <font>
                            <Font size="14" />
                        </font>
                    </Label>

                    <ComboBox
                            fx:id="cbDocumentDisponible"
                            prefWidth="280"
                            prefHeight="51"
                            promptText="Choisir un document disponible" />

                    <DatePicker
                            fx:id="dpDateEmprunt"
                            prefWidth="190"
                            prefHeight="51" />

                    <Button
                            fx:id="btnBorrow"
                            text="Emprunter"
                            prefWidth="140"
                            prefHeight="50">
                        <styleClass>
                            <String fx:value="btn" />
                            <String fx:value="btn-primary" />
                        </styleClass>
                    </Button>

                </children>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
