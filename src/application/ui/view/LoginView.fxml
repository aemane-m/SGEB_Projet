<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" maxWidth="513.0" prefHeight="347.0" prefWidth="513.0" spacing="14" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.ui.viewmodel.controller.LoginController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <children>

        <Label styleClass="title" text="Connexion à la bibliothèque" />

        <VBox fx:id="loginPane" alignment="CENTER" maxWidth="421.0" prefHeight="259.0" prefWidth="421.0" spacing="10">

            <children>

                <TextField fx:id="usernameField" maxWidth="Infinity" promptText="Email" />

                <PasswordField fx:id="passwordField" maxWidth="Infinity" promptText="Mot de passe" />

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <children>
                        <ProgressIndicator fx:id="progress" managed="false" prefHeight="18" prefWidth="18" visible="false" />
                        <Region prefHeight="37.0" prefWidth="229.0" HBox.hgrow="ALWAYS" />
                        <!-- classes CSS séparées par un espace, pas une virgule -->
                        <Button fx:id="btnLogin" maxWidth="Infinity" prefHeight="37.0" prefWidth="0.0" styleClass="btn-primary" text="Se connecter" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <Label fx:id="errorLabel" managed="false" styleClass="error-message" visible="false" wrapText="true" />

                <Label prefHeight="50.0" prefWidth="340.0" styleClass="helper-text" text="Vous n’avez pas encore de compte adhérent ? Retournez à l’écran d’accueil et utilisez le bouton « Créer un compte »." wrapText="true" />

                <Hyperlink fx:id="lnkForgotPassword" onAction="#onForgotPasswordClicked" styleClass="btn-link" text="Mot de passe oublié ?" />

                <!-- 🔙 Bouton retour Landing -->
                <Button fx:id="btnBackToLanding" maxWidth="Infinity" onAction="#onBackToLandingClicked" styleClass="btn-link" text="Retour à l’écran d’accueil" />

            </children>
        </VBox>

    </children>
</VBox>
