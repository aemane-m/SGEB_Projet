<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      maxWidth="420"
      prefWidth="420"
      spacing="14"
      stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.ui.viewmodel.controller.LoginController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label styleClass="title" text="Connexion à la bibliothèque" />

    <VBox fx:id="loginPane" alignment="CENTER" maxWidth="340" spacing="10">

        <TextField fx:id="usernameField"
                   maxWidth="Infinity"
                   promptText="Email" />

        <PasswordField fx:id="passwordField"
                       maxWidth="Infinity"
                       promptText="Mot de passe" />

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <ProgressIndicator fx:id="progress"
                               managed="false"
                               prefHeight="18"
                               prefWidth="18"
                               visible="false" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnLogin"
                    maxWidth="Infinity"
                    text="Se connecter"
                    styleClass="btn, btn-primary"
                    HBox.hgrow="ALWAYS" />
        </HBox>

        <Label fx:id="errorLabel"
               managed="false"
               styleClass="error-message"
               visible="false"
               wrapText="true" />

        <Label wrapText="true"
               styleClass="helper-text"
               text="Vous n’avez pas encore de compte adhérent ? Retournez à l’écran d’accueil et utilisez le bouton « Créer un compte »." />

        <!-- 🔙 Bouton retour Landing -->
        <Button fx:id="btnBackToLanding"
                text="Retour à l’écran d’accueil"
                styleClass="btn-link"
                maxWidth="Infinity"
                onAction="#onBackToLandingClicked" />

    </VBox>

</VBox>