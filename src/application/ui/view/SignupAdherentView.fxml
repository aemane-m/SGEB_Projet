<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" maxWidth="420" prefWidth="420" spacing="12" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.ui.viewmodel.controller.SignupAdherentController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Création d'un compte adhérent" />

    <Label text="Remplissez ce formulaire pour créer votre compte." wrapText="true" />

    <TextField fx:id="nomField" maxWidth="Infinity" promptText="Nom" />

    <TextField fx:id="prenomField" maxWidth="Infinity" promptText="Prénom" />

    <TextField fx:id="emailField" maxWidth="Infinity" promptText="Email" />

    <PasswordField fx:id="passwordField" maxWidth="Infinity" promptText="Mot de passe (min. 6 caractères)" />

    <PasswordField fx:id="confirmPasswordField" maxWidth="Infinity" promptText="Confirmer le mot de passe" />

    <Label fx:id="errorLabel" managed="false" style="-fx-text-fill: red;" visible="false" wrapText="true" />

    <Label fx:id="infoLabel" managed="false" style="-fx-text-fill: green;" visible="false" wrapText="true" />

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnBack" onAction="#onBackToLandingClicked" styleClass="btn-danger" text="Retour à l'accueil" />

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="btnCreate" defaultButton="true" onAction="#onCreateClicked" styleClass="btn-primary" text="Créer mon compte" />
    </HBox>

</VBox>
