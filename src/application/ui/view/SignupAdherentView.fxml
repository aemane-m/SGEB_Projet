<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.ui.viewmodel.controller.SignupAdherentController"
      spacing="12"
      alignment="CENTER"
      prefWidth="420"
      maxWidth="420">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Création d'un compte adhérent"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label text="Remplissez ce formulaire pour créer votre compte."
           wrapText="true"/>

    <TextField fx:id="emailField"
               promptText="Email"
               maxWidth="Infinity"/>

    <PasswordField fx:id="passwordField"
                   promptText="Mot de passe (min. 6 caractères)"
                   maxWidth="Infinity"/>

    <!-- ✅ Champ manquant : confirmation du mot de passe -->
    <PasswordField fx:id="confirmPasswordField"
                   promptText="Confirmer le mot de passe"
                   maxWidth="Infinity"/>

    <TextField fx:id="prenomField"
               promptText="Prénom"
               maxWidth="Infinity"/>

    <TextField fx:id="nomField"
               promptText="Nom"
               maxWidth="Infinity"/>

    <Label fx:id="errorLabel"
           visible="false"
           managed="false"
           style="-fx-text-fill: red;"
           wrapText="true"/>

    <Label fx:id="infoLabel"
           visible="false"
           managed="false"
           style="-fx-text-fill: green;"
           wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnBack"
                text="Retour à l'accueil"
                onAction="#onBackToLandingClicked"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="btnCreate"
                text="Créer mon compte"
                defaultButton="true"
                onAction="#onCreateClicked"/>
    </HBox>

</VBox>