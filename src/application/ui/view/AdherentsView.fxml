<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="16" styleClass="dashboard-root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.ui.viewmodel.controller.AdherentsController"> <padding>
        <Insets bottom="28" left="48" right="48" top="20" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label styleClass="title" text="Gestion des adhérents" />
        <Region HBox.hgrow="ALWAYS" /> <Button fx:id="btnAdd" styleClass="btn, btn-primary" text="Ajouter un adhérent">
            <graphic>
                <StackPane styleClass="svg-icon-btn">
                    <SVGPath content="M 11 2 L 11 11 L 2 11 L 2 13 L 11 13 L 11 22 L 13 22 L 13 13 L 22 13 L 22 11 L 13 11 L 13 2 L 11 2 z" />
                </StackPane>
            </graphic>
        </Button>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" promptText="Rechercher par ID, nom ou prénom" HBox.hgrow="ALWAYS" />
        <Button fx:id="btnSearch" styleClass="btn, btn-secondary" text="Rechercher">
             <graphic>
                <StackPane styleClass="svg-icon-btn">
                    <SVGPath content="M 9.5 3 C 6.467 3 4 5.467 4 8.5 C 4 11.533 6.467 14 9.5 14 C 10.849 14 12.064281 13.551062 13.042969 12.822266 L 17.292969 17.070312 L 18.707031 15.65625 L 14.457031 11.40625 C 15.343281 10.404281 15 9.043 15 8.5 C 15 5.467 12.533 3 9.5 3 z M 9.5 5 C 11.433 5 13 6.567 13 8.5 C 13 10.433 11.433 12 9.5 12 C 7.567 12 6 10.433 6 8.5 C 6 6.567 7.567 5 9.5 5 z" />
                </StackPane>
            </graphic>
        </Button>
        <ProgressIndicator fx:id="progress" managed="false" prefHeight="24" prefWidth="24" visible="false" />
        <Button fx:id="btnRefresh" styleClass="btn, btn-secondary" text="Rafraîchir">
             <graphic>
                <StackPane styleClass="svg-icon-btn">
                    <SVGPath content="M 12 4 C 7.581722 4 4 7.581722 4 12 C 4 16.418278 7.581722 20 12 20 C 16.418278 20 20 16.418278 20 12 C 20 9.46721 18.841584 7.185686 17.070312 5.570312 L 15.65625 6.984375 C 17.078437 8.270687 18 10.046914 18 12 C 18 15.313708 15.313708 18 12 18 C 8.6862915 18 6 15.313708 6 12 C 6 8.6862915 8.6862915 6 12 6 L 12 8 L 16 5 L 12 2 L 12 4 z" />
                </StackPane>
            </graphic>
        </Button>
    </HBox>

    <TableView fx:id="table" styleClass="table-view" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" minWidth="60" prefWidth="80" text="ID" />
            <TableColumn fx:id="colNom" minWidth="150.0" prefWidth="150.0" resizable="false" text="Nom" />
            <TableColumn fx:id="colPrenom" minWidth="160.0" prefWidth="160.0" resizable="false" text="Prénom" />
            <TableColumn fx:id="colEmail" minWidth="190.0" prefWidth="190.0" resizable="false" text="Email" />
            <TableColumn fx:id="colStatut" minWidth="140.0" prefWidth="140.0" resizable="false" text="Statut" />
            <TableColumn fx:id="colAction" minWidth="310.0" prefWidth="310.0" resizable="false" text="Actions" />
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
        <placeholder><Label text="Aucun adhérent à afficher." /></placeholder>
    </TableView>

    <Label fx:id="errorLabel" managed="false" styleClass="error-message" visible="false" wrapText="true" />

</VBox>
