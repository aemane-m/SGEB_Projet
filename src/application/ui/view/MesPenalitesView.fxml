<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="553.0" prefWidth="668.0" spacing="8" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.ui.viewmodel.controller.MesPenalitesController">

    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>

    <HBox spacing="8">
        <children>
            <Button fx:id="btnRefresh" styleClass="btn-primary" text="Rafraîchir" />
            <ProgressIndicator fx:id="progress" prefHeight="20" prefWidth="20" />
        </children>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDoc" prefWidth="123.0" resizable="false" text="Document" />
            <TableColumn fx:id="colDate" prefWidth="81.0" resizable="false" text="Date" />
            <TableColumn fx:id="colMontant" prefWidth="89.0" resizable="false" text="Montant" />
            <TableColumn fx:id="colStatut" prefWidth="106.0" resizable="false" text="Statut" />
            <TableColumn fx:id="colAction" prefWidth="179.0" resizable="false" text="Action" />
        </columns>
    </TableView>

    <Label fx:id="errorLabel" styleClass="error-label" />
    <Label fx:id="successLabel" styleClass="success-label" />
</VBox>
