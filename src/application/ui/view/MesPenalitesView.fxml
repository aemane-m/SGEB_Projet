<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="553" prefWidth="668" spacing="8" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.ui.viewmodel.controller.MesPenalitesController">

    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>

    <!-- ====== BARRE D'ACTION ====== -->
    <HBox alignment="CENTER_LEFT" spacing="8">
        <children>
            <Button fx:id="btnRefresh" text="Rafraîchir">
                <styleClass>
                    <String fx:value="btn" />
                    <String fx:value="btn-primary" />
                </styleClass>
            </Button>

            <ProgressIndicator fx:id="progress" managed="false" prefHeight="20" prefWidth="20" visible="false" />
        </children>
    </HBox>

    <!-- ====== TABLE DES PÉNALITÉS ====== -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDoc" prefWidth="171.0" resizable="false" text="Document" />

            <TableColumn fx:id="colDate" prefWidth="93.0" resizable="false" text="Date" />

            <TableColumn fx:id="colMontant" prefWidth="109.0" resizable="false" text="Montant" />

            <TableColumn fx:id="colStatut" prefWidth="88.0" resizable="false" text="Statut" />

            <TableColumn fx:id="colAction" prefWidth="185.0" resizable="false" text="Action" />
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <!-- ====== MESSAGES ====== -->
    <Label fx:id="errorLabel" managed="false" styleClass="error-message" visible="false" wrapText="true" />

    <Label fx:id="successLabel" managed="false" styleClass="success-message" visible="false" wrapText="true" />

</VBox>
